PORT=3000

# Mapbox — required for the globe
MAPBOX_TOKEN=pk.ey...

# Tailscale HTTPS (optional — leave blank for plain HTTP)
TAILSCALE_CERT=
TAILSCALE_KEY=
TAILSCALE_HOST=

# Whisper transcription (optional)
# Download model: https://github.com/ggerganov/whisper.cpp
WHISPER_BIN=
WHISPER_MODEL=

# Last.fm ambient music polling (optional)
# Get a free API key at https://www.last.fm/api/account/create
# Polls every 10 min for scrobbles, every 30s for now-playing
LASTFM_API_KEY=
LASTFM_USERNAME=

# Syncthing photo ingest (optional)
# Point to the folder where Syncthing syncs photos from your phone
SYNCTHING_MEDIA_DIR=

# Embeddings via Ollama (optional)
# Run: ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434

# Data directory (optional — defaults to packages/server/data)
MEMOIR_DATA_DIR=
