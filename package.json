{
  "name": "memoir",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r --if-present dev",
    "build": "pnpm --filter @memoir/contract build && pnpm -r --filter=!@memoir/contract build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "tsx": "^4.22.1",
    "typescript": "^5.4.0"
  }
}
